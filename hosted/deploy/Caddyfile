# One certificate for the apex and the wildcard, by DNS-01.
#
# {$VAR} is substituted from Caddy's own environment before the file is parsed,
# and compose.yaml puts the four values there. That is what lets one Caddyfile
# serve any operator's domain and any caddy-dns module.
#
# A provider whose module takes an inline argument (Cloudflare wants its token)
# sets WAKU_DNS_PROVIDER to the whole directive, for example
#   WAKU_DNS_PROVIDER="cloudflare {env.CLOUDFLARE_API_TOKEN}"
# Route 53 takes none: it reads AWS credentials from config/caddy.env.
#
# THE SITE ADDRESS IS A CLOSED SET. Two names and no more: the apex and one
# label under it. Caddy serves nothing it was not given a matching site block
# for, so a request arriving with any other Host is refused here rather than
# forwarded to the gateway to be sorted out. The wildcard matches exactly one
# label, which is what a tenant id is.
#
# reverse_proxy passes the original Host upstream by default, and the gateway
# routes by Host -- apex or tenant -- so that default is load-bearing. Do not
# add a header_up that rewrites it.
#
# flush_interval -1 disables response buffering. Without it a streamed turn
# (/api/chat/stream, /api/graph/stream) arrives at the browser in one lump when
# the turn ends, which looks exactly like a hung dashboard.

{
	email {$WAKU_ACME_EMAIL}
}

{$WAKU_DOMAIN}, *.{$WAKU_DOMAIN} {
	tls {
		dns {$WAKU_DNS_PROVIDER}

		# RESOLVERS AND A PROPAGATION WAIT, BOTH MEASURED RATHER THAN GUESSED.
		#
		# Measured on the first real VM, 2026-09-28: Caddy asked Let's Encrypt
		# to validate 4.6 SECONDS after writing the TXT record, and Route 53
		# takes 30 to 60 to publish it, so every attempt died on "No TXT record
		# found at _acme-challenge.<domain>". The apex still issued, so the
		# deployment came up looking healthy while every tenant host answered
		# ERR_SSL_PROTOCOL_ERROR -- which reads as a broken tenant rather than
		# a missing certificate. It is a race that does win sometimes, which is
		# worse than never working: it can come up and fail on renewal.
		#
		# resolvers is the subtler half. Caddy's own propagation check runs
		# against the container's resolver, here 127.0.0.53 (systemd-resolved),
		# which answers instantly from cache and reports the record present
		# before it is. Only a public resolver sees what the CA sees. The
		# hand-built Caddyfile this replaced had `resolvers 1.1.1.1`, and the
		# line was lost in the move to a container.
		resolvers 1.1.1.1 8.8.8.8
		propagation_delay 30s
		propagation_timeout 5m
	}

	reverse_proxy {$WAKU_GATEWAY_ADDRESS} {
		flush_interval -1
	}
}
