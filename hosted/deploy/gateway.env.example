# config/gateway.env -- read by the gateway alone, as an env_file (spec, "How
# the services run"). install.sh writes the real one; this is the list of
# names, pinned in both directions by
# evals/deterministic/hosted/test_gateway.py.
#
# Nothing here is a secret. The JWKS holds a public key and the publishable
# key is meant for a browser; the gateway holds no Supabase credential at all.

WAKU_APEX_HOST=agent.waku.one
WAKU_GATEWAY_BIND=127.0.0.1
WAKU_GATEWAY_PORT=8787
WAKU_CONTROL_DB=/srv/waku/control/control.db
WAKU_SPAWNER_SOCKET=/srv/waku/run/spawner/spawner.sock
WAKU_GATEWAY_SOCKET=/srv/waku/run/gateway/gateway.sock
WAKU_PROXY_SOCKET=/srv/waku/run/proxy/proxy.sock
WAKU_ADMIN_SOCKET=/srv/waku/run/admin/admin.sock
WAKU_MAX_RUNNING=95
WAKU_SUPABASE_URL=https://upmikpuftlvvpwkvouqr.supabase.co
WAKU_SUPABASE_ISSUER=https://upmikpuftlvvpwkvouqr.supabase.co/auth/v1
WAKU_SUPABASE_JWKS_URL=https://upmikpuftlvvpwkvouqr.supabase.co/auth/v1/.well-known/jwks.json
# NOT "authenticated". That is the `role` claim; this project's tokens carry a
# custom audience for Waku Memory's MCP.
WAKU_SUPABASE_AUDIENCE=https://api.waku.one/mcp
WAKU_SUPABASE_PUBLISHABLE_KEY=sb_publishable_bIMuCu3jYiMqslf2AZml2A_l8Lo2Dqv
WAKU_FREE_TURNS_PER_HOUR=30
WAKU_BYOK_TURNS_PER_HOUR=120
