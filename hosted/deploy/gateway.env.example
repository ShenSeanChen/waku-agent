# config/gateway.env -- read by the gateway alone, as an env_file (spec, "How
# the services run"). install.sh writes the real one; this is the list of
# names, pinned in both directions by
# evals/deterministic/hosted/test_gateway.py.
#
# The Supabase values are public: the JWKS holds a public key and the
# publishable key is meant for a browser. The last three Slack values and
# WAKU_AGENT_PLATFORM_SECRET are secrets, so the real file is 0600 and
# readable by root alone.

WAKU_APEX_HOST=agent.waku.one
WAKU_GATEWAY_BIND=127.0.0.1
WAKU_GATEWAY_PORT=8787
WAKU_CONTROL_DB=/srv/waku/control/control.db
WAKU_SPAWNER_SOCKET=/srv/waku/run/spawner/spawner.sock
WAKU_GATEWAY_SOCKET=/srv/waku/run/gateway/gateway.sock
WAKU_PROXY_SOCKET=/srv/waku/run/proxy/proxy.sock
WAKU_ADMIN_SOCKET=/srv/waku/run/admin/admin.sock
WAKU_MAX_RUNNING=95
WAKU_SUPABASE_URL=https://upmikpuftlvvpwkvouqr.supabase.co
WAKU_SUPABASE_ISSUER=https://upmikpuftlvvpwkvouqr.supabase.co/auth/v1
WAKU_SUPABASE_JWKS_URL=https://upmikpuftlvvpwkvouqr.supabase.co/auth/v1/.well-known/jwks.json
# NOT "authenticated". That is the `role` claim; this project's tokens carry a
# custom audience for Waku Memory's MCP.
WAKU_SUPABASE_AUDIENCE=https://api.waku.one/mcp
WAKU_SUPABASE_PUBLISHABLE_KEY=sb_publishable_bIMuCu3jYiMqslf2AZml2A_l8Lo2Dqv
WAKU_FREE_TURNS_PER_HOUR=30
WAKU_BYOK_TURNS_PER_HOUR=120
# Spec 008: the pages allowed to frame the agent's chat (/embed/chat), as a
# space-separated list of origins. Optional: a gateway.env without this line
# uses exactly these three. To develop waku.one locally, write the whole list
# with http://localhost:3000 added.
WAKU_EMBED_ORIGINS=https://www.waku.one https://waku.one https://dev.waku.one
# Spec 001 E4: stop a tenant's container after this many minutes with nothing
# in flight and no non-background request. Their next message starts a new one
# from the current tenant image. Optional: a gateway.env without this line
# uses 15. A whole number, at least 1.
WAKU_IDLE_MINUTES=15
# Spec 026 C: the public Waku Slack app ("Add to Slack"). The first three come
# from the app's settings page at api.slack.com/apps, under Basic Information,
# and are entered here by hand. Until all four have a value the gateway starts
# and its Slack routes answer 503, naming the empty names.
WAKU_SLACK_CLIENT_ID=
WAKU_SLACK_CLIENT_SECRET=
WAKU_SLACK_SIGNING_SECRET=
# The key that seals each workspace's bot token in control.db: 64 hexadecimal
# characters. install.sh generates it on the VM. Never copy one from anywhere,
# and never change it: the tokens already stored would stop opening. For a VM
# installed before spec 026, make one with
#   od -An -N32 -tx1 /dev/urandom | tr -d ' \n'
WAKU_SLACK_TOKEN_KEY=
# Spec 029 F: the GitHub App a person signs in to GitHub through, read-only.
# Both come from the app's own page at github.com, under Settings, Developer
# settings, GitHub Apps: the Client ID, and a client secret generated there.
# They are entered here by hand (hosted/README.md, "GitHub"). Until both have
# a value the gateway starts and GitHub is not a connector on this server:
# no card on /setup, and an agent that says GitHub cannot be connected here.
WAKU_GITHUB_CLIENT_ID=
WAKU_GITHUB_CLIENT_SECRET=
# Spec 032: the secret waku.one sends with each call to /v1/team-homes, as
# `Authorization: Bearer <value>`. The same value is set on waku.one as its
# own WAKU_AGENT_PLATFORM_SECRET. Make one with
#   openssl rand -hex 32
# and enter it in both places by hand. It is at least 32 characters. Whoever
# holds it can make a team home here, so it is never put in a chat, an issue
# or a commit. Until it has a value the gateway starts and those routes
# answer 503. They also need WAKU_SLACK_TOKEN_KEY above, which seals each
# team's Waku Memory key in control.db.
WAKU_AGENT_PLATFORM_SECRET=
