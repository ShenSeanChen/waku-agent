# config/backup.env -- written by install.sh, read by backup.sh and restore.sh
# as root. Root-only: it holds the credential that can read every tenant's
# data out of the object store.
#
# restic's own variable names, because backup.sh exports this file wholesale
# and runs restic with it.

RESTIC_REPOSITORY='s3:s3.amazonaws.com/example-waku-backups'
RESTIC_PASSWORD_FILE='/srv/waku/config/restic-password'

# SINGLE-QUOTE THESE. This file is SOURCED AS SHELL, by root, inside the backup
# timer at 03:17: a key holding `$` is silently truncated, and one holding a
# backtick or `$(...)` is a command substitution performed as root. install.sh
# quotes the two values above for exactly that reason; these two are yours.
AWS_ACCESS_KEY_ID='AKIAEXAMPLE'
AWS_SECRET_ACCESS_KEY='example'
