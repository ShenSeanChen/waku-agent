# config/spawner.env -- written by install.sh (F1), read by the spawner only.
#
# Root-only (spec, design section 7): Compose passes this as an env_file, which
# the Compose CLI reads as root, so no service user can read config/.
#
# Every name here is in hosted/spawner/template.py's ENV_NAMES, and
# test_container_template.py pins the two lists against each other in BOTH
# directions -- a name here that nothing reads is a value the operator set and
# the spawner ignored, which is worse than a missing one because it looks
# configured.

WAKU_TENANT_ROOT=/srv/waku/tenants
WAKU_ARCHIVE_ROOT=/srv/waku/archive
WAKU_STAGING_ROOT=/srv/waku/staging
WAKU_TENANT_IMAGE=waku-tenant:latest
WAKU_SERVICES_IMAGE=waku-services:latest

# install.sh --free-model writes this model into BOTH this file and the proxy's
# allowlist in proxy.env, so the two can never disagree (spec, the container
# template table). The free tier's allowlist is one model, so both the model
# and the small model name it: the retrieval gate uses the small model, and a
# small model outside the allowlist would be refused on every turn and silently
# fail open.
WAKU_PLATFORM_BASE_URL=http://10.88.0.1:8788
WAKU_PLATFORM_MODEL=claude-haiku-4-5
WAKU_PLATFORM_SMALL_MODEL=claude-haiku-4-5

# install.sh --tenant-disk, in bytes. 1 GB is the default.
WAKU_TENANT_DISK_BYTES=1073741824

# The data disk's block device, passed to the spawner's container with
# `devices:`. xfs_quota needs it to set a project limit from inside a container.
#
# The literal `none` means "set no quota", logs a WARNING on every provision,
# and exists only so the Docker test suite can start a spawner on a machine
# with no XFS. install.sh never writes it. An EMPTY value is refused outright
# by config_from_env, so a misspelling in install.sh cannot turn every tenant's
# disk limit off by accident -- somebody has to type the word.
WAKU_DATA_DEVICE=/dev/sdb1

WAKU_SECCOMP_PROFILE=/app/hosted/image/seccomp.json
