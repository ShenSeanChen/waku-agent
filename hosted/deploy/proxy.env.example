# config/proxy.env -- written by install.sh, read by the metering proxy alone.
#
# Pinned by hosted/proxy/config.REQUIRED_ENV_NAMES (spec 004 C, which builds
# spec 001's group D).
#
# Every number here is the spec's ("The proxy, per model call", and "Two plans"):
# the $1 monthly cap, 4 concurrent calls, 60 requests a minute and a 4 MiB
# body limit. Two are spec 004's: a max_tokens ceiling of 8192, because thinking
# counts as output, and 16 calls at once across every tenant. They live beside the service that
# enforces them, which is why they are here and not in control.db.

WAKU_PROXY_BIND=10.88.0.1
WAKU_PROXY_PORT=8788
WAKU_LEDGER_DB=/srv/waku/ledger/ledger.db
WAKU_GATEWAY_SOCKET=/srv/waku/run/gateway/gateway.sock
WAKU_PROXY_SOCKET=/srv/waku/run/proxy/proxy.sock

# The platform's model key. It exists in this file and in the proxy's
# environment, and nowhere else on the VM: no tenant container ever holds it
# (acceptance 2).
#
# install.sh reads it from the file named by --platform-key-file and never from
# a command-line value, which would land in root's shell history and in the
# process list. Delete that file once install.sh has run: this file is the
# copy that is meant to survive, root-only at mode 0600.
WAKU_PLATFORM_KEY=sk-ant-example

# install.sh --free-model and --free-small-model write these into BOTH this
# file and spawner.env, so the allowlist and the models the tenant's waku
# selects can never disagree. Every model here needs a row in prices.py.
WAKU_FREE_MODELS=claude-sonnet-5-5,claude-haiku-4-5

WAKU_FREE_MONTHLY_CAP_USD=1
WAKU_FREE_CONCURRENT_CALLS=4
WAKU_FREE_REQUESTS_PER_MINUTE=60
WAKU_GLOBAL_CONCURRENT_CALLS=16
WAKU_MAX_TOKENS_CEILING=8192
WAKU_MAX_BODY_BYTES=4194304
WAKU_UPSTREAM_BASE_URL=https://api.anthropic.com
