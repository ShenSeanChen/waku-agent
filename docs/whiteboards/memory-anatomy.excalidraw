      "roundness": null,
      "seed": 1274836067,
      "version": 1,
      "versionNonce": 648208758,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Every system here consolidates FORWARD-ONLY, on the critical path.\nSo it only ever sees the recent window \u2014 it cannot merge duplicates\nwritten months apart, or notice a contradiction it never saw together.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Every system here consolidates FORWARD-ONLY, on the critical path.\nSo it only ever sees the recent window \u2014 it cannot merge duplicates\nwritten months apart, or notice a contradiction it never saw together.",
      "lineHeight": 1.25
    },
