    {
      "id": "txt-0083",
      "type": "text",
      "x": 1698.0,
      "y": 967.0,
      "width": 616.0,
      "height": 60.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
