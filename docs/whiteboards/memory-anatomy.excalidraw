    },
    {
      "id": "txt-0094",
      "type": "text",
      "x": 1698.0,
      "y": 1412.0,
      "width": 536.8000000000001,
      "height": 360.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 408858366,
      "version": 1,
      "versionNonce": 1929714705,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "A FEW DOZEN facts, one user\n     no retrieval at all. MEMORY.md fits in the prompt, and a\n     search costs more than it saves.\n\nHUNDREDS, and you know the words that will be used\n     keyword (FTS5). No embeddings, no vector bill, no extra\n     service \u2014 and exact terms beat similarity.\n\nTHOUSANDS \u2014 or the question arrives paraphrased, or in \u4e2d\u6587\n     vector = RAG. This is the rung where embeddings start\n     paying for themselves. Not before.\n\nfacts that RELATE to each other\n     graph. \"who else was at that meeting\" is a traversal,\n     not a search.\n\nfacts that CHANGE\n     graph + validity intervals. Superseded is not deleted.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A FEW DOZEN facts, one user\n     no retrieval at all. MEMORY.md fits in the prompt, and a\n     search costs more than it saves.\n\nHUNDREDS, and you know the words that will be used\n     keyword (FTS5). No embeddings, no vector bill, no extra\n     service \u2014 and exact terms beat similarity.\n\nTHOUSANDS \u2014 or the question arrives paraphrased, or in \u4e2d\u6587\n     vector = RAG. This is the rung where embeddings start\n     paying for themselves. Not before.\n\nfacts that RELATE to each other\n     graph. \"who else was at that meeting\" is a traversal,\n     not a search.\n\nfacts that CHANGE\n     graph + validity intervals. Superseded is not deleted.",
      "lineHeight": 1.25
    },
