      "versionNonce": 1035485675,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Both mem0 and Zep mark the dead fact dead \u2014 and BOTH still return it\nfrom a plain search. mem0 scored the superseded row 0.3474 against\n0.3429 for the live one. Read the lifecycle field, or ship the wrong date.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Both mem0 and Zep mark the dead fact dead \u2014 and BOTH still return it\nfrom a plain search. mem0 scored the superseded row 0.3474 against\n0.3429 for the live one. Read the lifecycle field, or ship the wrong date.",
      "lineHeight": 1.25
    },
