<mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="pi — the minimal coding agent" style="text;html=1;align=left;verticalAlign=top;fontColor=#1e1e1e;strokeColor=none;fillColor=none;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=32;" vertex="1" parent="1"><mxGeometry x="60" y="30" width="571" height="42" as="geometry"/></mxCell><mxCell id="subtitle" value="github.com/earendil-works/pi · 72K stars · TypeScript · MIT&#xa;by Mario Zechner (libGDX) · now at Earendil (Armin Ronacher)" style="text;html=1;align=left;verticalAlign=top;fontColor=#666666;strokeColor=none;fillColor=none;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="80" width="518" height="36" as="geometry"/></mxCell><mxCell id="boundary" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#e03131;dashed=1;strokeWidth=2;sketch=1;curveFitting=1;jiggle=2;fontColor=#e03131;align=center;verticalAlign=middle;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="1720" height="950" as="geometry"/></mxCell><mxCell id="boundary-note" value="NO permission system — on purpose. pi runs with YOUR user's powers.&#xa;&quot;If you need stronger boundaries, containerize&quot; — the container IS the boundary." style="text;html=1;align=left;verticalAlign=top;fontColor=#e03131;strokeColor=none;fillColor=none;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=15;" vertex="1" parent="1"><mxGeometry x="60" y="1100" width="736" height="39" as="geometry"/></mxCell><mxCell id="fe-head" value="FRONTENDS — one EventStream, four faces" style="text;html=1;align=left;verticalAlign=top;fontColor=#1e1e1e;strokeColor=none;fillColor=none;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=16;" vertex="1" parent="1"><mxGeometry x="80" y="170" width="387" height="21" as="geometry"/></mxCell><mxCell id="fe-tui" value="TUI (interactive)&#xa;pi" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f5ff;strokeColor=#1e1e1e;fillStyle=solid;strokeWidth=2;sketch=1;curveFitting=1;jiggle=2;fontColor=#1e1e1e;align=center;verticalAlign=middle;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=14;" vertex="1" parent="1"><mxGeometry x="80" y="210" width="200" height="54" as="geometry"/></mxCell><mxCell id="fe-print" value="print mode&#xa;pi -p &quot;task&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f5ff;strokeColor=#1e1e1e;fillStyle=solid;strokeWidth=2;sketch=1;curveFitting=1;jiggle=2;fontColor=#1e1e1e;align=center;verticalAlign=middle;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=14;" vertex="1" parent="1"><mxGeometry x="80" y="280" width="200" height="54" as="geometry"/></mxCell><mxCell id="fe-json" value="event stream&#xa;pi --mode json" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f5ff;strokeColor=#1e1e1e;fillStyle=solid;strokeWidth=2;sketch=1;curveFitting=1;jiggle=2;fontColor=#1e1e1e;align=center;verticalAlign=middle;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=14;" vertex="1" parent="1"><mxGeometry x="80" y="350" width="200" height="54" as="geometry"/></mxCell><mxCell id="fe-rpc" value="long-lived RPC&#xa;pi --mode rpc" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f5ff;strokeColor=#1e1e1e;fillStyle=solid;strokeWidth=2;sketch=1;curveFitting=1;jiggle=2;fontColor=#1e1e1e;align=center;verticalAlign=middle;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=14;" vertex="1" parent="1"><mxGeometry x="80" y="420" width="200" height="54" as="geometry"/></mxCell><mxCell id="fe-note" value="same events → any frontend&#xa;(this is how Waku plugs in: -p)" style="text;html=1;align=left;verticalAlign=top;fontColor=#1971c2;strokeColor=none;fillColor=none;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=13;" vertex="1" parent="1"><mxGeometry x="80" y="492" width="254" height="34" as="geometry"/></mxCell><mxCell id="a-fe-loop" value="" style="startArrow=none;endArrow=open;startFill=0;endFill=0;html=1;strokeColor=#1e1e1e;rounded=1;strokeWidth=2;sketch=1;curveFitting=1;jiggle=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="290" y="340" as="sourcePoint"/><mxPoint x="420" y="340" as="targetPoint"/></mxGeometry></mxCell><mxCell id="loop" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9db;strokeColor=#1e1e1e;fillStyle=solid;strokeWidth=2;sketch=1;curveFitting=1;jiggle=2;fontColor=#1e1e1e;align=center;verticalAlign=middle;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=16;" vertex="1" parent="1"><mxGeometry x="430" y="200" width="430" height="330" as="geometry"/></mxCell><mxCell id="loop-head" value="THE LOOP — pi-agent-core" style="text;html=1;align=left;verticalAlign=top;fontColor=#1e1e1e;strokeColor=none;fillColor=none;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=20;" vertex="1" parent="1"><mxGeometry x="450" y="215" width="300" height="26" as="geometry"/></mxCell><mxCell id="loop-body" value="a ~792-line while-loop in an EventStream&#xa;&#xa;while (tool calls or queued messages):&#xa;    inject STEERING (you can talk mid-run)&#xa;    stream one model turn&#xa;    run tool calls (parallel by default)&#xa;    emit events (turn_end, ...)&#xa;&#xa;compaction: auto-summarize when&#xa;context overflows" style="text;html=1;align=left;verticalAlign=top;fontColor=#1e1e1e;strokeColor=none;fillColor=none;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=14;" vertex="1" parent="1"><mxGeometry x="450" y="255" width="365" height="182" as="geometry"/></mxCell><mxCell id="loop-scar" value="scar tissue: truncated response? → fail ALL&#xa;tool calls (half-parsed JSON args lie)" style="text;html=1;align=left;verticalAlign=top;fontColor=#e8590c;strokeColor=none;fillColor=none;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=13;" vertex="1" parent="1"><mxGeometry x="450" y="470" width="348" height="34" as="geometry"/></mxCell><mxCell id="tools-head" value="TOOLS — four. that's it." style="text;html=1;align=left;verticalAlign=top;fontColor=#1e1e1e;strokeColor=none;fillColor=none;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=18;" vertex="1" parent="1"><mxGeometry x="430" y="570" width="272" height="23" as="geometry"/></mxCell><mxCell id="tool-read" value="read&#xa;files+images" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d3f9d8;strokeColor=#1e1e1e;fillStyle=solid;strokeWidth=2;sketch=1;curveFitting=1;jiggle=2;fontColor=#1e1e1e;align=center;verticalAlign=middle;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=13;" vertex="1" parent="1"><mxGeometry x="430" y="610" width="100" height="60" as="geometry"/></mxCell><mxCell id="tool-bash" value="bash&#xa;run anything" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d3f9d8;strokeColor=#1e1e1e;fillStyle=solid;strokeWidth=2;sketch=1;curveFitting=1;jiggle=2;fontColor=#1e1e1e;align=center;verticalAlign=middle;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=13;" vertex="1" parent="1"><mxGeometry x="542" y="610" width="100" height="60" as="geometry"/></mxCell><mxCell id="tool-edit" value="edit&#xa;exact replace" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d3f9d8;strokeColor=#1e1e1e;fillStyle=solid;strokeWidth=2;sketch=1;curveFitting=1;jiggle=2;fontColor=#1e1e1e;align=center;verticalAlign=middle;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=13;" vertex="1" parent="1"><mxGeometry x="654" y="610" width="100" height="60" as="geometry"/></mxCell><mxCell id="tool-write" value="write&#xa;new files" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d3f9d8;strokeColor=#1e1e1e;fillStyle=solid;strokeWidth=2;sketch=1;curveFitting=1;jiggle=2;fontColor=#1e1e1e;align=center;verticalAlign=middle;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=13;" vertex="1" parent="1"><mxGeometry x="766" y="610" width="100" height="60" as="geometry"/></mxCell><mxCell id="tools-opt" value="opt-in extras: grep · find · ls" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#1e1e1e;dashed=1;strokeWidth=2;sketch=1;curveFitting=1;jiggle=2;fontColor=#1e1e1e;align=center;verticalAlign=middle;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=13;" vertex="1" parent="1"><mxGeometry x="430" y="690" width="320" height="44" as="geometry"/></mxCell><mxCell id="tools-note" value="everything else is NOT a built-in →" style="text;html=1;align=left;verticalAlign=top;fontColor=#2f9e44;strokeColor=none;fillColor=none;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=14;" vertex="1" parent="1"><mxGeometry x="430" y="750" width="307" height="18" as="geometry"/></mxCell><mxCell id="a-tools-ext" value="" style="startArrow=none;endArrow=open;startFill=0;endFill=0;html=1;strokeColor=#2f9e44;rounded=1;dashed=1;strokeWidth=2;sketch=1;curveFitting=1;jiggle=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="700" y="760" as="sourcePoint"/><mxPoint x="940" y="700" as="targetPoint"/></mxGeometry></mxCell><mxCell id="ext" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f0ff;strokeColor=#7048e8;fillStyle=solid;strokeWidth=2;sketch=1;curveFitting=1;jiggle=2;fontColor=#7048e8;align=center;verticalAlign=middle;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=16;" vertex="1" parent="1"><mxGeometry x="950" y="200" width="380" height="560" as="geometry"/></mxCell><mxCell id="ext-head" value="EXTENSIONS — where features live" style="text;html=1;align=left;verticalAlign=top;fontColor=#7048e8;strokeColor=none;fillColor=none;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=18;" vertex="1" parent="1"><mxGeometry x="970" y="215" width="359" height="23" as="geometry"/></mxCell><mxCell id="ext-body" value="plain TypeScript files, hot-loaded (jiti)&#xa;~/.pi/agent/extensions/*.ts or .pi/&#xa;&#xa;~30 lifecycle hooks:&#xa;  input · tool_call (can BLOCK) ·&#xa;  context · session_compact · ...&#xa;&#xa;pi.registerTool / Command / Provider&#xa;&#xa;~70 examples shipped:&#xa;  permission-gate (opt-in safety!)&#xa;  plan mode · subagents&#xa;  git-checkpoint · micro-VM sandbox&#xa;  ...a playable DOOM overlay&#xa;&#xa;&quot;pi can create extensions.&#xa; Ask it to build one.&quot;  ← the thesis" style="text;html=1;align=left;verticalAlign=top;fontColor=#1e1e1e;strokeColor=none;fillColor=none;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=14;" vertex="1" parent="1"><mxGeometry x="970" y="255" width="358" height="309" as="geometry"/></mxCell><mxCell id="piai" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff0f6;strokeColor=#c2255c;fillStyle=solid;strokeWidth=2;sketch=1;curveFitting=1;jiggle=2;fontColor=#c2255c;align=center;verticalAlign=middle;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=16;" vertex="1" parent="1"><mxGeometry x="80" y="800" width="560" height="210" as="geometry"/></mxCell><mxCell id="piai-head" value="pi-ai — the provider funnel" style="text;html=1;align=left;verticalAlign=top;fontColor=#c2255c;strokeColor=none;fillColor=none;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=18;" vertex="1" parent="1"><mxGeometry x="100" y="815" width="304" height="23" as="geometry"/></mxCell><mxCell id="piai-body" value="37 providers (Anthropic, OpenAI, Google, Groq,&#xa;OpenRouter, DeepSeek, MiniMax, Kimi, ...)&#xa;        ↓  collapse onto  ↓&#xa;11 wire-format adapters (a provider = just data)&#xa;&#xa;Context is plain JSON → swap providers MID-SESSION" style="text;html=1;align=left;verticalAlign=top;fontColor=#1e1e1e;strokeColor=none;fillColor=none;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=14;" vertex="1" parent="1"><mxGeometry x="100" y="855" width="434" height="109" as="geometry"/></mxCell><mxCell id="sess" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6fcf5;strokeColor=#087f5b;fillStyle=solid;strokeWidth=2;sketch=1;curveFitting=1;jiggle=2;fontColor=#087f5b;align=center;verticalAlign=middle;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=16;" vertex="1" parent="1"><mxGeometry x="680" y="800" width="560" height="210" as="geometry"/></mxCell><mxCell id="sess-head" value="SESSIONS — one JSONL file, a TREE" style="text;html=1;align=left;verticalAlign=top;fontColor=#087f5b;strokeColor=none;fillColor=none;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=18;" vertex="1" parent="1"><mxGeometry x="700" y="815" width="370" height="23" as="geometry"/></mxCell><mxCell id="sess-body" value="every line: {id, parentId, message}&#xa;→ branch IN-PLACE: /tree time-travel, /fork&#xa;→ /share (gist) · publish to Hugging Face&#xa;&#xa;open sessions instead of benchmarks:&#xa;the community's eval substrate" style="text;html=1;align=left;verticalAlign=top;fontColor=#1e1e1e;strokeColor=none;fillColor=none;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=14;" vertex="1" parent="1"><mxGeometry x="700" y="855" width="374" height="109" as="geometry"/></mxCell><mxCell id="op-head" value="MY TAKE (from reading&#xa;the source):" style="text;html=1;align=left;verticalAlign=top;fontColor=#e03131;strokeColor=none;fillColor=none;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=17;" vertex="1" parent="1"><mxGeometry x="1380" y="200" width="226" height="44" as="geometry"/></mxCell><mxCell id="op-elegant" value="elegant:&#xa;+ 4-tool discipline is REAL&#xa;  (extensions carry the rest)&#xa;+ one event stream,&#xa;  four frontends&#xa;+ providers = data,&#xa;  not code" style="text;html=1;align=left;verticalAlign=top;fontColor=#2f9e44;strokeColor=none;fillColor=none;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1380" y="270" width="255" height="127" as="geometry"/></mxCell><mxCell id="op-gaps" value="gaps (by design):&#xa;- NO MEMORY&#xa;  compaction != remembering&#xa;- NO EVALS&#xa;  sessions != a release gate&#xa;- no safety net&#xa;  (container or YOLO)" style="text;html=1;align=left;verticalAlign=top;fontColor=#e03131;strokeColor=none;fillColor=none;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1380" y="470" width="248" height="127" as="geometry"/></mxCell><mxCell id="a-gap-waku1" value="" style="startArrow=none;endArrow=open;startFill=0;endFill=0;html=1;strokeColor=#e03131;rounded=1;strokeWidth=2;sketch=1;curveFitting=1;jiggle=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1575" y="500" as="sourcePoint"/><mxPoint x="1650" y="500" as="targetPoint"/></mxGeometry></mxCell><mxCell id="a-gap-waku2" value="" style="startArrow=none;endArrow=open;startFill=0;endFill=0;html=1;strokeColor=#e03131;rounded=1;strokeWidth=2;sketch=1;curveFitting=1;jiggle=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1575" y="545" as="sourcePoint"/><mxPoint x="1650" y="545" as="targetPoint"/></mxGeometry></mxCell><mxCell id="op-waku" value="→ Waku's&#xa;   pillars" style="text;html=1;align=left;verticalAlign=top;fontColor=#1971c2;strokeColor=none;fillColor=none;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1655" y="495" width="100" height="39" as="geometry"/></mxCell><mxCell id="op-thesis" value="the collab thesis:&#xa;memory + evals belong to&#xa;the ORCHESTRATOR (Waku).&#xa;tools belong to the&#xa;SPECIALIST (pi).&#xa;&#xa;so Waku hires pi:&#xa;delegate_task → pi -p" style="text;html=1;align=left;verticalAlign=top;fontColor=#1971c2;strokeColor=none;fillColor=none;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1380" y="640" width="228" height="156" as="geometry"/></mxCell></root></mxGraphModel>