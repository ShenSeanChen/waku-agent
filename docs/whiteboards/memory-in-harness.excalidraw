      "versionNonce": 648208758,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Zep: a project-wide ontology set in a signup wizard shapes every user's graph \u2014 and deleting every user never clears it.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Zep: a project-wide ontology set in a signup wizard shapes every user's graph \u2014 and deleting every user never clears it.",
      "lineHeight": 1.25
    },
