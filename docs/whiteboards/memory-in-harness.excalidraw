      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "and what the interface HIDES",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "and what the interface HIDES",
      "lineHeight": 1.25
    },
    {
      "id": "txt-0068",
      "type": "text",
      "x": 1698.0,
      "y": 712.0,
      "width": 589.6,
      "height": 80.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 113005316,
      "version": 1,
      "versionNonce": 1633861655,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "The FactStore contract says a write must always store. To honour it\nthe mem0 adapter passes infer=False \u2014 which switches OFF the single\nfeature mem0 is known for. A common interface is how you compare\nthem fairly AND how you stop seeing what they are.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The FactStore contract says a write must always store. To honour it\nthe mem0 adapter passes infer=False \u2014 which switches OFF the single\nfeature mem0 is known for. A common interface is how you compare\nthem fairly AND how you stop seeing what they are.",
      "lineHeight": 1.25
    },
