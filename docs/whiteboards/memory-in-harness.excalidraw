      "versionNonce": 1753536851,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "the loop \u00b7 the retrieval gate \u00b7 SKILL.md and procedural memory\nthe episodic log \u00b7 the consolidator \u00b7 the harness \u00b7 the gateways\nOne box of seven. That is the whole market, in one diagram.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "the loop \u00b7 the retrieval gate \u00b7 SKILL.md and procedural memory\nthe episodic log \u00b7 the consolidator \u00b7 the harness \u00b7 the gateways\nOne box of seven. That is the whole market, in one diagram.",
      "lineHeight": 1.25
