      "versionNonce": 1873212047,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "sqlite      rows + FTS5 keyword          (default)\nmem0        rows + vector, LLM decides add/update/delete\nzep         temporal graph, edges carry validity\nlangmem     whatever store YOU bring; the manager is the product\nsupabase    rows + pgvector, textbook RAG, no manager at all",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "sqlite      rows + FTS5 keyword          (default)\nmem0        rows + vector, LLM decides add/update/delete\nzep         temporal graph, edges carry validity\nlangmem     whatever store YOU bring; the manager is the product\nsupabase    rows + pgvector, textbook RAG, no manager at all",
      "lineHeight": 1.25
    },
