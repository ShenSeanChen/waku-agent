      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "SCOPE \u2014 waku: one user, one machine.   mem0: shared across agents in an org.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SCOPE \u2014 waku: one user, one machine.   mem0: shared across agents in an org.",
      "lineHeight": 1.25
    },
    {
