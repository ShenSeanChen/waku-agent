<mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="txt-0001" value="pi vs Claude Code — two bets on the harness" style="text;html=1;align=left;verticalAlign=top;fontColor=#1e1e1e;strokeColor=none;fillColor=none;fontSize=28;" vertex="1" parent="1"><mxGeometry x="60" y="40" width="738" height="35" as="geometry"/></mxCell><mxCell id="lin-0002" value="" style="startArrow=none;endArrow=none;startFill=0;endFill=0;html=1;strokeColor=#e8590c;strokeWidth=2;sketch=1;curveFitting=1;jiggle=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="64" y="84" as="sourcePoint"/><mxPoint x="1044" y="84" as="targetPoint"/><Array as="points"><mxPoint x="309" y="88"/><mxPoint x="554" y="82"/><mxPoint x="799" y="88"/></Array></mxGeometry></mxCell><mxCell id="txt-0003" value="same job: turn a model into a coding agent. opposite answers to one question —&#xa;WHO owns the context window: the vendor, or you?" style="text;html=1;align=left;verticalAlign=top;fontColor=#1e1e1e;strokeColor=none;fillColor=none;fontSize=16;" vertex="1" parent="1"><mxGeometry x="60" y="108" width="765" height="40" as="geometry"/></mxCell><mxCell id="rec-0004" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#e03131;strokeWidth=2;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="80" y="190" width="1150" height="758" as="geometry"/></mxCell><mxCell id="txt-0005" value="Claude Code — batteries included" style="text;html=1;align=left;verticalAlign=top;fontColor=#e03131;strokeColor=none;fillColor=none;fontSize=20;" vertex="1" parent="1"><mxGeometry x="106" y="208" width="397" height="25" as="geometry"/></mxCell><mxCell id="rec-0006" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#e03131;strokeWidth=2;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="1340" y="190" width="1150" height="758" as="geometry"/></mxCell><mxCell id="txt-0007" value="pi — you are the batteries" style="text;html=1;align=left;verticalAlign=top;fontColor=#e03131;strokeColor=none;fillColor=none;fontSize=20;" vertex="1" parent="1"><mxGeometry x="1366" y="208" width="325" height="25" as="geometry"/></mxCell><mxCell id="rec-0008" value="TOOLS:  15+ built-ins — Read / Write / Edit / Bash /&#xa;Grep / Glob / Task / WebFetch / Todo ..." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1e1e1e;fillStyle=solid;strokeWidth=2;sketch=1;curveFitting=1;jiggle=2;fontColor=#1e1e1e;align=center;verticalAlign=middle;fontSize=16;" vertex="1" parent="1"><mxGeometry x="110" y="250" width="1090" height="78" as="geometry"/></mxCell><mxCell id="rec-0010" value="TOOLS:  four — read / write / edit / bash.&#xa;everything else is an extension, not a built-in" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1e1e1e;fillStyle=solid;strokeWidth=2;sketch=1;curveFitting=1;jiggle=2;fontColor=#1e1e1e;align=center;verticalAlign=middle;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1370" y="250" width="1090" height="78" as="geometry"/></mxCell><mxCell id="rec-0012" value="CONTEXT:  big system prompt + injected reminders,&#xa;hooks, tool schemas — the vendor curates it" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1e1e1e;fillStyle=solid;strokeWidth=2;sketch=1;curveFitting=1;jiggle=2;fontColor=#1e1e1e;align=center;verticalAlign=middle;fontSize=16;" vertex="1" parent="1"><mxGeometry x="110" y="336" width="1090" height="78" as="geometry"/></mxCell><mxCell id="rec-0014" value="CONTEXT:  system prompt under 1k tokens.&#xa;&quot;nothing enters context you didn't put there&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2f9e44;fillStyle=solid;strokeWidth=2;sketch=1;curveFitting=1;jiggle=2;fontColor=#1e1e1e;align=center;verticalAlign=middle;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1370" y="336" width="1090" height="78" as="geometry"/></mxCell><mxCell id="rec-0016" value="SUB-AGENTS:  built-in Task tool spawns workers&#xa;(black box within a black box)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1e1e1e;fillStyle=solid;strokeWidth=2;sketch=1;curveFitting=1;jiggle=2;fontColor=#1e1e1e;align=center;verticalAlign=middle;fontSize=16;" vertex="1" parent="1"><mxGeometry x="110" y="422" width="1090" height="78" as="geometry"/></mxCell><mxCell id="rec-0018" value="SUB-AGENTS:  refused — spawn pi yourself: tmux,&#xa;or waku's delegate_task (that's us)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1e1e1e;fillStyle=solid;strokeWidth=2;sketch=1;curveFitting=1;jiggle=2;fontColor=#1e1e1e;align=center;verticalAlign=middle;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1370" y="422" width="1090" height="78" as="geometry"/></mxCell><mxCell id="rec-0020" value="MCP:  first-class: servers, connectors,&#xa;schemas loaded into context" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1e1e1e;fillStyle=solid;strokeWidth=2;sketch=1;curveFitting=1;jiggle=2;fontColor=#1e1e1e;align=center;verticalAlign=middle;fontSize=16;" vertex="1" parent="1"><mxGeometry x="110" y="508" width="1090" height="78" as="geometry"/></mxCell><mxCell id="rec-0022" value="MCP:  refused — a CLI + README, read only when&#xa;needed (Playwright MCP alone = 13.7k tokens)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1e1e1e;fillStyle=solid;strokeWidth=2;sketch=1;curveFitting=1;jiggle=2;fontColor=#1e1e1e;align=center;verticalAlign=middle;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1370" y="508" width="1090" height="78" as="geometry"/></mxCell><mxCell id="rec-0024" value="PLAN / TODOS:  plan mode + TodoWrite,&#xa;state lives inside the harness" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1e1e1e;fillStyle=solid;strokeWidth=2;sketch=1;curveFitting=1;jiggle=2;fontColor=#1e1e1e;align=center;verticalAlign=middle;fontSize=16;" vertex="1" parent="1"><mxGeometry x="110" y="594" width="1090" height="78" as="geometry"/></mxCell><mxCell id="rec-0026" value="PLAN / TODOS:  PLAN.md / TODO.md — files you can see&#xa;(&quot;built-in to-dos confuse models&quot;)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1e1e1e;fillStyle=solid;strokeWidth=2;sketch=1;curveFitting=1;jiggle=2;fontColor=#1e1e1e;align=center;verticalAlign=middle;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1370" y="594" width="1090" height="78" as="geometry"/></mxCell><mxCell id="rec-0028" value="PERMISSIONS:  popups, permission modes,&#xa;sandboxed tool calls" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1e1e1e;fillStyle=solid;strokeWidth=2;sketch=1;curveFitting=1;jiggle=2;fontColor=#1e1e1e;align=center;verticalAlign=middle;fontSize=16;" vertex="1" parent="1"><mxGeometry x="110" y="680" width="1090" height="78" as="geometry"/></mxCell><mxCell id="rec-0030" value="PERMISSIONS:  none — runs with YOUR user's powers.&#xa;want safety? run it in a container" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1e1e1e;fillStyle=solid;strokeWidth=2;sketch=1;curveFitting=1;jiggle=2;fontColor=#1e1e1e;align=center;verticalAlign=middle;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1370" y="680" width="1090" height="78" as="geometry"/></mxCell><mxCell id="rec-0032" value="SESSIONS:  linear history + compaction&#xa;when context fills up" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1e1e1e;fillStyle=solid;strokeWidth=2;sketch=1;curveFitting=1;jiggle=2;fontColor=#1e1e1e;align=center;verticalAlign=middle;fontSize=16;" vertex="1" parent="1"><mxGeometry x="110" y="766" width="1090" height="78" as="geometry"/></mxCell><mxCell id="rec-0034" value="SESSIONS:  a TREE in one JSONL {id, parentId} —&#xa;/fork /tree /clone time-travel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2f9e44;fillStyle=solid;strokeWidth=2;sketch=1;curveFitting=1;jiggle=2;fontColor=#1e1e1e;align=center;verticalAlign=middle;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1370" y="766" width="1090" height="78" as="geometry"/></mxCell><mxCell id="rec-0036" value="PROVIDERS + LICENSE:  Anthropic models,&#xa;closed source" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1e1e1e;fillStyle=solid;strokeWidth=2;sketch=1;curveFitting=1;jiggle=2;fontColor=#1e1e1e;align=center;verticalAlign=middle;fontSize=16;" vertex="1" parent="1"><mxGeometry x="110" y="852" width="1090" height="78" as="geometry"/></mxCell><mxCell id="rec-0038" value="PROVIDERS + LICENSE:  37 providers via pi-ai (Kimi, DeepSeek,&#xa;GLM, ...) - MIT - ~72k stars" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1e1e1e;fillStyle=solid;strokeWidth=2;sketch=1;curveFitting=1;jiggle=2;fontColor=#1e1e1e;align=center;verticalAlign=middle;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1370" y="852" width="1090" height="78" as="geometry"/></mxCell><mxCell id="rec-0040" value="waku uses BOTH: Claude Code writes waku's code - pi is waku's delegate_task sub-agent,&#xa;on whatever model the loop is running. pi refused to build sub-agents — which is exactly what makes it embeddable as one." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2f9e44;fillStyle=solid;strokeWidth=2;sketch=1;curveFitting=1;jiggle=2;fontColor=#1e1e1e;align=center;verticalAlign=middle;fontSize=16;" vertex="1" parent="1"><mxGeometry x="80" y="988" width="2410" height="96" as="geometry"/></mxCell><mxCell id="txt-0042" value="honest ink: &quot;minimal&quot; doesn't delete complexity — pi relocates it to 2,100+ community packages. trust moves to third parties, it doesn't vanish." style="text;html=1;align=left;verticalAlign=top;fontColor=#e03131;strokeColor=none;fillColor=none;fontSize=16;" vertex="1" parent="1"><mxGeometry x="80" y="1116" width="1404" height="20" as="geometry"/></mxCell><mxCell id="txt-0043" value="per mariozechner.at 'what i learned building a minimal coding agent' (2025-11-30) - earendil-works/pi docs + source (read 2026-07-24) - implicator.ai (2026-04)" style="text;html=1;align=left;verticalAlign=top;fontColor=#868e96;strokeColor=none;fillColor=none;fontSize=16;" vertex="1" parent="1"><mxGeometry x="80" y="1164" width="1549" height="20" as="geometry"/></mxCell><mxCell id="txt-0044" value="GitHub  @ShenSeanChen" style="text;html=1;align=left;verticalAlign=top;fontColor=#1e1e1e;strokeColor=none;fillColor=none;fontSize=16;" vertex="1" parent="1"><mxGeometry x="2160" y="40" width="214" height="20" as="geometry"/></mxCell><mxCell id="txt-0045" value="YouTube @SeanAIStories" style="text;html=1;align=left;verticalAlign=top;fontColor=#1e1e1e;strokeColor=none;fillColor=none;fontSize=16;" vertex="1" parent="1"><mxGeometry x="2160" y="64" width="223" height="20" as="geometry"/></mxCell><mxCell id="txt-0046" value="X       @ShenSeanChen" style="text;html=1;align=left;verticalAlign=top;fontColor=#1e1e1e;strokeColor=none;fillColor=none;fontSize=16;" vertex="1" parent="1"><mxGeometry x="2160" y="88" width="214" height="20" as="geometry"/></mxCell><mxCell id="txt-0047" value="@ShenSeanChen" style="text;html=1;align=left;verticalAlign=top;fontColor=#868e96;strokeColor=none;fillColor=none;fontSize=16;" vertex="1" parent="1"><mxGeometry x="80" y="1204" width="135" height="20" as="geometry"/></mxCell></root></mxGraphModel>