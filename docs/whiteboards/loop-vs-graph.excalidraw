      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "a SKILL.md is a procedure the model MAY follow.  a graph is the same procedure it CANNOT NOT follow.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "a SKILL.md is a procedure the model MAY follow.  a graph is the same procedure it CANNOT NOT follow.",
      "lineHeight": 1.25
    },
    {
