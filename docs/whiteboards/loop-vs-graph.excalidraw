      "versionNonce": 1866542167,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Mostly yes. Airflow has run conditional parallel DAGs for a decade.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Mostly yes. Airflow has run conditional parallel DAGs for a decade.",
      "lineHeight": 1.25
    },
    {
      "id": "txt-0133",
