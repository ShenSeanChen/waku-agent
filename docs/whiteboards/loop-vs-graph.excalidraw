      "versionNonce": 944061808,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "a graph only speeds up what can be parallel. an 11s model\ncall dominates both runs \u2014 if your workflow is one big call\nwearing a hat, a graph buys almost nothing.\n\nTHE REAL WIN IS THAT A GRAPH CAN'T FORGET.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "a graph only speeds up what can be parallel. an 11s model\ncall dominates both runs \u2014 if your workflow is one big call\nwearing a hat, a graph buys almost nothing.\n\nTHE REAL WIN IS THAT A GRAPH CAN'T FORGET.",
      "lineHeight": 1.25
    },
