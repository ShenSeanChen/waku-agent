      "updated": 1,
      "link": null,
      "locked": false,
      "text": "\"ISN'T THIS JUST DETERMINISTIC WORKFLOWS FROM 2023?\"",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "rec-0130",
      "originalText": "\"ISN'T THIS JUST DETERMINISTIC WORKFLOWS FROM 2023?\"",
      "lineHeight": 1.25
    },
    {
      "id": "txt-0132",
      "type": "text",
      "x": 1190.0,
      "y": 1396.0,
      "width": 589.6,
      "height": 20.0,
      "angle": 0,
